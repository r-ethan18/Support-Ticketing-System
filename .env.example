# Support Ticketing System - Environment Configuration
# Copy this file to .env and adjust values for your local deployment.

# JWT Secret for access token signing (must be >= 32 characters)
JWT_SECRET=supersecretjwtkeyforlocaldevelopment32chars

# Database Configuration
POSTGRES_DB=sts
POSTGRES_USER=sts
POSTGRES_PASSWORD=stslocaldevpassword
DB_HOST=localhost
DB_PORT=5432

# Bootstrap Administrator Account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpassword123

# Attachment storage (Garage). Garage creates this access key and bucket on
# first start; the backend uses them too. Formats are enforced by Garage:
#   S3_ACCESS_KEY  "GK" + 32 hex chars    (GK$(openssl rand -hex 16))
#   S3_SECRET_KEY  64 hex chars           ($(openssl rand -hex 32))
#   GARAGE_RPC_SECRET  64 hex chars       ($(openssl rand -hex 32))
# These are throwaway local values; generate your own for anything shared.
S3_ACCESS_KEY=GK0123456789abcdef0123456789abcdef
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_RPC_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
