# Support Ticketing System - Environment Configuration
# Copy this file to .env and adjust values for your local deployment.

# JWT Secret for access token signing (must be >= 32 characters)
JWT_SECRET=supersecretjwtkeyforlocaldevelopment32chars

# Database Configuration
POSTGRES_DB=sts
POSTGRES_USER=sts
POSTGRES_PASSWORD=stslocaldevpassword
DB_HOST=localhost
DB_PORT=5432

# Bootstrap Administrator Account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpassword123
